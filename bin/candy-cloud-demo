#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
state=${CANDY_CLOUD_DEMO_STATE_DIR:-$root/.candy-cloud-demo.local}
secrets="$state/secrets"
env_file="$state/demo.env"
project=${CANDY_CLOUD_DEMO_PROJECT:-candy-cloud-demo}
port=${CLOUD_DEMO_PORT:-8088}

for command in curl docker openssl; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "candy-cloud-demo: missing required command: $command" >&2
    exit 1
  }
done
docker info >/dev/null 2>&1 || {
  echo "candy-cloud-demo: Docker is not running" >&2
  exit 1
}

compose() {
  docker compose --project-name "$project" --env-file "$env_file" \
    -f "$root/docker-compose.yml" -f "$root/docker-compose.demo.yml" "$@"
}

compose_tls() {
  docker compose --project-name "$project" --env-file "$env_file" \
    -f "$root/docker-compose.yml" -f "$root/docker-compose.demo.yml" \
    -f "$root/docker-compose.demo-tls.yml" "$@"
}

activate_web() {
  web_container=$(compose ps -q cloud-web)
  test -n "$web_container" || {
    echo 'candy-cloud-demo: cloud-web container is not running' >&2
    exit 1
  }
  source_container=$(docker create candy-cloud-demo-cloud-web:local)
  web_stage=$(mktemp -d "${TMPDIR:-/tmp}/candy-cloud-demo-web.XXXXXX")
  cleanup_web() {
    docker rm -f "$source_container" >/dev/null 2>&1 || :
    rm -rf "$web_stage"
  }
  trap cleanup_web EXIT INT TERM
  docker cp "$source_container:/srv/." "$web_stage/"
  docker rm "$source_container" >/dev/null
  source_container=
  test -s "$web_stage/index.html"
  test -d "$web_stage/assets"
  docker run --rm --volumes-from "$web_container" \
    -v "$web_stage:/image-web:ro" busybox:1.37.0-musl sh -eu -c '
      mkdir -p /srv/assets
      cp -R /image-web/assets/. /srv/assets/
      if test -d /image-web/install; then
        rm -rf /srv/.install.next
        cp -R /image-web/install /srv/.install.next
        rm -rf /srv/install
        mv /srv/.install.next /srv/install
      fi
      cp /image-web/index.html /srv/.index.html.new
      mv /srv/.index.html.new /srv/index.html
    '
  cleanup_web
  trap - EXIT INT TERM
}

initialize() {
  test ! -f "$env_file" || return 0
  umask 077
  mkdir -p "$secrets"

  openssl genpkey -algorithm ED25519 -out "$secrets/cloud-api-auth-private.pem" >/dev/null 2>&1
  openssl pkey -in "$secrets/cloud-api-auth-private.pem" -pubout \
    -out "$secrets/cloud-api-auth-public.pem" >/dev/null 2>&1
  openssl rand 32 > "$secrets/cloud-signing.key"
  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -subj '/CN=Candy Demo Device CA' \
    -keyout "$secrets/device-ca.key" -out "$secrets/device-ca.pem" >/dev/null 2>&1
  # The Demo proxy is HTTP-only, but base Compose validates all secret paths.
  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -subj '/CN=Candy Demo TLS CA' -addext 'basicConstraints=critical,CA:TRUE' \
    -addext 'keyUsage=critical,keyCertSign,cRLSign' \
    -keyout "$secrets/cloud-tls-ca.key" -out "$secrets/cloud-tls-ca.pem" >/dev/null 2>&1
  openssl req -newkey rsa:2048 -nodes -subj '/CN=localhost' \
    -keyout "$secrets/cloud-tls.key" -out "$secrets/cloud-tls.csr" >/dev/null 2>&1
  printf '%s\n' 'subjectAltName=DNS:localhost,IP:127.0.0.1' 'basicConstraints=critical,CA:FALSE' 'keyUsage=critical,digitalSignature,keyEncipherment' 'extendedKeyUsage=serverAuth' >"$secrets/cloud-tls.ext"
  openssl x509 -req -days 3650 -sha256 -in "$secrets/cloud-tls.csr" \
    -CA "$secrets/cloud-tls-ca.pem" -CAkey "$secrets/cloud-tls-ca.key" -CAcreateserial \
    -extfile "$secrets/cloud-tls.ext" -out "$secrets/cloud-tls.pem" >/dev/null 2>&1

  mysql_root=$(openssl rand -hex 24)
  mysql_migrator=$(openssl rand -hex 24)
  mysql_api=$(openssl rand -hex 24)
  mysql_identity=$(openssl rand -hex 24)
  mysql_auth=$(openssl rand -hex 24)
  mysql_worker=$(openssl rand -hex 24)
  route_key=$(openssl rand -hex 32)

  {
    echo 'MYSQL_DATABASE=candy_cloud_demo'
    echo "MYSQL_ROOT_PASSWORD=$mysql_root"
    echo "MYSQL_MIGRATOR_PASSWORD=$mysql_migrator"
    echo "MYSQL_API_PASSWORD=$mysql_api"
    echo "MYSQL_IDENTITY_PASSWORD=$mysql_identity"
    echo "MYSQL_AUTH_PASSWORD=$mysql_auth"
    echo "MYSQL_WORKER_PASSWORD=$mysql_worker"
    echo 'CANDY_ROUTE_SIGNING_KEY_ID=demo-route'
    echo "CANDY_ROUTE_SIGNING_KEY_HEX=$route_key"
    echo 'CORE_MODULE_VERSION=0.3.10'
    echo 'CORE_MODULE_TARGET=x86_64-unknown-linux-gnu'
    echo 'CORE_MODULE_BUNDLE_SHA256=b41806ff17359a9ec8151deb61b206403ec01b14aaffd8f7d456111ab0cc042d'
    echo 'CORE_MODULE_SHA256=54c1e6a1f61ef0b28208d5dec13ce7b1351922478987b5eac3ac9a06f183c478'
    echo "CLOUD_SIGNING_KEY_FILE=$secrets/cloud-signing.key"
    echo 'CLOUD_SIGNING_KEY_ID=demo-grant'
    echo 'CLOUD_ISSUER_ID=00000000-0000-0000-0000-000000000001'
    echo 'CLOUD_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000002'
    echo "CLOUD_DEVICE_CA_CERT_FILE=$secrets/device-ca.pem"
    echo "CLOUD_DEVICE_CA_KEY_FILE=$secrets/device-ca.key"
    echo 'CLOUD_DEVICE_CA_KEY_ID=demo-device-ca'
    echo 'CLOUD_ENVIRONMENT=development'
    echo "CLOUD_API_AUTH_PUBLIC_KEY_FILE=$secrets/cloud-api-auth-public.pem"
    echo "CLOUD_IDENTITY_SIGNING_KEY_FILE=$secrets/cloud-api-auth-private.pem"
    echo "CLOUD_IDENTITY_VERIFICATION_KEY_FILE=$secrets/cloud-api-auth-public.pem"
    echo 'CLOUD_IDENTITY_SIGNING_KEY_ID=demo-management'
    echo "CLOUD_API_AUTH_ISSUER=http://localhost:$port/identity"
    echo 'CLOUD_API_AUTH_AUDIENCE=candy-cloud-management'
    echo "CLOUD_TLS_CERTIFICATE_FILE=$secrets/cloud-tls.pem"
    echo "CLOUD_TLS_KEY_FILE=$secrets/cloud-tls.key"
    echo "CLOUD_DEMO_PORT=$port"
  } > "$env_file"
  chmod 0600 "$env_file"
}

case "${1:-up}" in

  tls)
    initialize
    if ! test -s "$secrets/cloud-tls-ca.pem" || ! openssl verify -CAfile "$secrets/cloud-tls-ca.pem" "$secrets/cloud-tls.pem" >/dev/null 2>&1; then
      umask 077
      openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
        -subj '/CN=Candy Demo TLS CA' -addext 'basicConstraints=critical,CA:TRUE' \
        -addext 'keyUsage=critical,keyCertSign,cRLSign' \
        -keyout "$secrets/cloud-tls-ca.key" -out "$secrets/cloud-tls-ca.pem" >/dev/null 2>&1
      openssl req -newkey rsa:2048 -nodes -subj '/CN=localhost' \
        -keyout "$secrets/cloud-tls.key" -out "$secrets/cloud-tls.csr" >/dev/null 2>&1
      printf '%s\n' 'subjectAltName=DNS:localhost,IP:127.0.0.1' 'basicConstraints=critical,CA:FALSE' 'keyUsage=critical,digitalSignature,keyEncipherment' 'extendedKeyUsage=serverAuth' >"$secrets/cloud-tls.ext"
      openssl x509 -req -days 3650 -sha256 -in "$secrets/cloud-tls.csr" \
        -CA "$secrets/cloud-tls-ca.pem" -CAkey "$secrets/cloud-tls-ca.key" -CAcreateserial \
        -extfile "$secrets/cloud-tls.ext" -out "$secrets/cloud-tls.pem" >/dev/null 2>&1
    fi
    if test "${CANDY_CLOUD_DEMO_SKIP_BUILD:-0}" != 1; then
      for service in cloud-web migrate cloud-api cloud-identity cloud-auth cloud-worker; do
        compose_tls build "$service"
      done
    fi
    compose_tls up -d --no-build reverse-proxy cloud-worker
    activate_web
    tls_port=${CLOUD_DEMO_TLS_PORT:-8443}
    for _ in $(seq 1 120); do
      if curl --silent --fail --cacert "$secrets/cloud-tls-ca.pem" "https://localhost:$tls_port/identity/health/ready" >/dev/null &&
        curl --silent --fail --cacert "$secrets/cloud-tls-ca.pem" "https://localhost:$tls_port/api/health/ready" >/dev/null; then
        break
      fi
      sleep 1
    done
    curl --silent --fail --cacert "$secrets/cloud-tls-ca.pem" "https://localhost:$tls_port/identity/health/ready" >/dev/null || {
      compose_tls ps -a >&2 || :
      compose_tls logs --no-color reverse-proxy cloud-api cloud-identity migrate mysql >&2 || :
      echo 'candy-cloud-demo: TLS demo did not become ready' >&2
      exit 1
    }
    echo "Candy Cloud TLS Demo: https://localhost:$tls_port"
    echo "CA certificate: $secrets/cloud-tls-ca.pem"
    echo 'Email: demo-owner@candy.local'
    echo 'Password: Candy-Demo-2026!'
    ;;
  up)
    initialize
    if test "${CANDY_CLOUD_DEMO_SKIP_BUILD:-0}" != 1; then
      for service in cloud-web migrate cloud-api cloud-identity cloud-auth cloud-worker; do
        compose build "$service"
      done
    fi
    compose up -d --no-build reverse-proxy cloud-worker
    activate_web
    for _ in $(seq 1 120); do
      if curl --silent --fail "http://localhost:$port/identity/health/ready" >/dev/null &&
        curl --silent --fail "http://localhost:$port/api/health/ready" >/dev/null; then
        break
      fi
      sleep 1
    done
    curl --silent --fail "http://localhost:$port/identity/health/ready" >/dev/null || {
      compose ps -a >&2 || :
      compose logs --no-color reverse-proxy cloud-api cloud-identity migrate mysql >&2 || :
      echo 'candy-cloud-demo: Identity did not become ready' >&2
      exit 1
    }
    curl --silent --fail "http://localhost:$port/api/health/ready" >/dev/null || {
      compose ps -a >&2 || :
      compose logs --no-color reverse-proxy cloud-api migrate mysql >&2 || :
      echo 'candy-cloud-demo: Cloud API did not become ready' >&2
      exit 1
    }
    echo "Candy Cloud Demo: http://localhost:$port"
    echo 'Email: demo-owner@candy.local'
    echo 'Password: Candy-Demo-2026!'
    ;;
  web)
    initialize
    compose_tls build cloud-web
    compose_tls up -d --no-build cloud-web reverse-proxy
    activate_web
    echo "Candy Cloud Web refreshed: http://localhost:$port"
    echo "Candy Cloud TLS Web refreshed: https://localhost:${CLOUD_DEMO_TLS_PORT:-8443}"
    ;;
  down)
    test -f "$env_file" || exit 0
    compose down --remove-orphans
    ;;
  reset)
    test -f "$env_file" || exit 0
    compose down --volumes --remove-orphans
    echo "Demo containers and database volume were removed; local keys remain in $state"
    ;;
  status)
    test -f "$env_file" || {
      echo 'Candy Cloud Demo has not been initialized'
      exit 0
    }
    compose ps -a
    ;;
  logs)
    test -f "$env_file" || {
      echo 'Candy Cloud Demo has not been initialized' >&2
      exit 1
    }
    shift
    if test "$#" -gt 0; then
      compose logs --no-color "$@"
    else
      compose logs --no-color
    fi
    ;;
  *)
    echo 'usage: bin/candy-cloud-demo [up|tls|web|down|reset|status|logs [service...]]' >&2
    exit 2
    ;;
esac
